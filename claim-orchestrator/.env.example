# Copy to .env (make does it). Local settings for docker compose.
TEMPORAL_HOST_PORT=27233
TEMPORAL_UI_HOST_PORT=28233
POSTGRES_HOST_PORT=25432
# Build ID every worker announces (Worker Versioning); make up makes it current.
BUILD_ID=v1
# Random transient failures in the mock systems, to exercise retries (0 to 1).
MOCK_FAILURE_RATE=0.03
# Shorter retry window than production so operations tasks can be seen locally.
RETRY_WINDOW_SECONDS=300
# ClaimsPro's agreed request rate (server-enforced on the claimspro-activities queue).
CLAIMSPRO_RATE_PER_SECOND=50
# Payload encryption (AES-256, base64). Empty = off. Generate: openssl rand -base64 32
PAYLOAD_KEY=
PAYLOAD_KEY_ID=key-1

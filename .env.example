# Host ports (change if something else on your machine already uses them)
TEMPORAL_HOST_PORT=17233
TEMPORAL_UI_HOST_PORT=8233
POSTGRES_HOST_PORT=15432
# Failure injection in the mock-data service (random 503s -> activity retries) and latency
MOCK_FAILURE_RATE=0.05
MOCK_LATENCY_MS=50
# false = pilot scope (Claims Lifecycle -> STP only)
TSA_ENABLED=true
IS_ENABLED=true
# Worker Deployment Versioning: build id the workers announce; make up promotes it to current
WORKER_VERSIONING=true
BUILD_ID=v1
